# GEMINI_API_KEY: Required for server-side Gemini AI calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE (Frontend public URL & anon/publishable key only — NEVER put service_role key in VITE_*)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE (Optional server-side token verification mirror)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC secret for fallback local demo session tokens.
SESSION_SECRET=""
